# Copy this file to aquatic-sustainability/backend/.env and fill values.
# That is the Flask app env — not repo-root /backend.
# Never commit .env or .venv.

# --- required to boot Flask ---
SECRET_KEY=

# --- maps (flood/coral/oil pages) + Places Nearby (enable Places API on this key or set GOOGLE_PLACES_API_KEY) ---
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- login ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- news feed (placeholders if empty) ---
NEWS_API_KEY=

# --- NASA SMAP/GPM for real flood grids; Docker entrypoint requires these ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- optional ---
REDIS_URL=redis://localhost:6379/0
MONGODB_URI=
PORT=5001
FAST_START_FLOOD_DATA=1

# --- Grokathon Safety Agent (not in BDBI upstream) ---
XAI_API_KEY=
X_BEARER_TOKEN=
GITHUB_TOKEN=

# Notify is dry-run only. Correct approval PIN logs intended recipients and
# shows success as if sent — it does NOT call Twilio, X, phone, or IPAWS.
# Rotate DEMO_APPROVAL_PIN before any real deployment.
NOTIFY_DRY_RUN=1
DEMO_APPROVAL_PIN=3408
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
