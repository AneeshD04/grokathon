# Copy to aquatic-sustainability/backend/.env — never commit it.

# --- required to boot Flask ---
SECRET_KEY=

# --- maps (flood/coral/oil pages) ---
GOOGLE_MAPS_API_KEY=

# --- login ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- news feed (placeholders if empty) ---
NEWS_API_KEY=

# --- NASA SMAP/GPM for real flood grids; Docker entrypoint requires these ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- optional ---
REDIS_URL=redis://localhost:6379/0
MONGODB_URI=
PORT=5001
FAST_START_FLOOD_DATA=1

# --- Grokathon Safety Agent (not in BDBI upstream) ---
XAI_API_KEY=
X_BEARER_TOKEN=
GITHUB_TOKEN=
