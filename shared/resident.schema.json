{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AneeshD04/grokathon/blob/main/shared/resident.schema.json",
  "title": "Resident",
  "description": "One opted-in resident. A region's resident list may be empty. Phone and email are not a live blast list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "phone": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 40 }
      ]
    },
    "email": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 200 }
      ]
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "geofence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
