{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AneeshD04/grokathon/blob/main/shared/watch.schema.json",
  "title": "Watch",
  "description": "Stored geofence watch. bbox is [minLon, minLat, maxLon, maxLat], and min must be less than max. At least one of bbox or county is required. An empty camera_ids list means every camera on that watch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "geofence_id", "sources", "camera_ids", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "geofence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "description": "[minLon, minLat, maxLon, maxLat]."
    },
    "county": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "enum": ["camera", "nws", "usgs", "x", "model", "news", "places", "transtar"]
      }
    },
    "camera_ids": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "ISO-8601 timestamp with a timezone."
    }
  },
  "anyOf": [
    { "required": ["bbox"] },
    { "required": ["county"] }
  ]
}
